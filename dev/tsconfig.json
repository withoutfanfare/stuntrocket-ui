{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["../src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["./**/*.ts", "./**/*.vue", "../src/**/*.ts", "../src/**/*.vue"],
  "exclude": ["../node_modules", "../dist"]
}
