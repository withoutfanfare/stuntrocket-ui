{
  "name": "@stuntrocket/ui",
  "version": "0.9.3",
  "sideEffects": ["**/*.css"],
  "description": "Stuntrocket shared UI component library — premium design system for Tauri desktop applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens.css": "./src/css/tokens.css",
    "./ambient.css": "./src/css/ambient.css",
    "./scrollbar.css": "./src/css/scrollbar.css",
    "./base.css": "./src/css/base.css",
    "./components.css": "./src/css/components.css",
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "src/css"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "dev:showcase": "vite --config dev/vite.config.ts",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.3",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.4",
    "jsdom": "^29.0.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.1",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.1.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.0"
  },
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "license": "MIT",
  "author": "Stuntrocket",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withoutfanfare/stuntrocket-ui.git"
  },
  "keywords": [
    "vue",
    "tailwind",
    "design-system",
    "components",
    "tauri"
  ]
}
